{
  "name": "codex-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny desktop pet that eats links and spits out summaries.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "smoke:ui": "electron scripts/drop-smoke.cjs",
    "screenshot": "electron . --screenshot docs/pet.png",
    "screenshot:result": "electron . --screenshot docs/pet-result.png --demo"
  },
  "dependencies": {
    "node-html-parser": "^9.0.6"
  },
  "devDependencies": {
    "electron": "^45.1.0"
  }
}
